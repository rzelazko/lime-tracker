{
  "name": "lime-tracker",
  "version": "1.0.134",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=en --host=0.0.0.0",
    "start-pl": "ng serve --configuration=pl --host=0.0.0.0",
    "build": "ng build --delete-output-path",
    "postbuild": "node scripts/postbuild.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase-emulator": "firebase emulators:start --only firestore,auth --import test-data",
    "i18n-extract": "ng extract-i18n --output-path src/locale"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/material-moment-adapter": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "apexcharts": "^6.10.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "moment": "^2.30.1",
    "moment-range": "^4.0.2",
    "ng-apexcharts": "^3.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.2.0",
    "firebase-tools": "^15.28.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "6.0.3",
    "xml2js": "^0.6.2"
  }
}
